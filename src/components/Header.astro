---
import Logo from './Logo.astro';
import Socials from './Socials.astro';
import links from '../content/menu/menu.json';
---

<header class="w-full relative">
	<div class="p-6 lg:px-8 mx-auto w-full max-w-7xl lg:flex lg:justify-between lg:gap-8 items-center">
		<a href="/" class="inline-block">
			<Logo />
		</a>

		<!-- Desktop: links -->
		<nav class="min-w-0 hidden lg:visible lg:flex flex-col items-end space-y-4" aria-label="Main navigation">
			<Socials size={30} />
			<div class="font-medium text-2xl text-black flex flex-wrap justify-end gap-x-5 gap-y-3" id="d-link-container">
				{links.map((link) => <a href={link.href}>{link.name}</a>)}
			</div>
		</nav>
	</div>

	<!-- The closed trigger stays in the header, clear of scrolled content. -->
	<button
		type="button"
		class="bg-white shadow-xl rounded-full p-4 absolute top-4 right-4 z-50 lg:hidden"
		aria-label="Open navigation menu"
		aria-controls="menu"
		aria-expanded="false"
		data-aw-toggle-menu
	>
		<svg width="40" height="40" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path
				d="M47.25 40.5H20.25V36H47.25V40.5ZM47.25 29.25H6.75V24.75H47.25V29.25ZM47.25 18H20.25V13.5H47.25V18Z"
				fill="var(--accent-color)"></path>
		</svg>
	</button>

	<!-- Mobile: Fixed menu -->
	<nav
		class="fixed top-0 left-0 w-full z-40 bg-black lg:hidden p-6"
		aria-label="Mobile navigation"
		id="menu"
		hidden
	>
		<div class="mobile-menu-content flex flex-col justify-between">
			<a href="/" aria-label="Dyne home"><Logo color="#FFEEDD" /></a>

			<ul class="lg:hidden text-2xl text-[#FFEEDD] w-full text-right">
				{
					links.map((pl) => (
						<li class="pb-6">
							<a href={pl.href} class="block py-4 px-2 lg:px-4">
								{pl.name}
							</a>
						</li>
					))
				}
			</ul>

			<Socials size={30} cls="fill-white" />
		</div>
	</nav>
	<noscript>
		<style>[data-aw-toggle-menu] { display: none; }</style>
		<nav aria-label="Main navigation without JavaScript" class="fallback-navigation lg:hidden">
			{links.map(link => <a href={link.href}>{link.name}</a>)}
		</nav>
	</noscript>
</header>

<style>
	[data-aw-toggle-menu][aria-expanded='true'] { position: fixed; }
	#menu { height: 100dvh; overflow-y: auto; overscroll-behavior: contain; }
	.mobile-menu-content { min-height: 100%; gap: 2rem; padding-top: 5rem; }
	.fallback-navigation { display: flex; flex-wrap: wrap; gap: 1rem; padding: 1.5rem; }
	@media (min-width: 1024px) { .fallback-navigation { display: none; } }
	#d-link-container a:last-child {
		color: var(--accent-color);
	}
	#d-link-container a { white-space: nowrap; }
</style>
