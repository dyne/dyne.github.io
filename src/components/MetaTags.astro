---
import { SITE } from '~/config.mjs';

const {
	title: suppliedTitle,
	description: suppliedDescription,
	canonical = SITE.origin,
	noindex = false,
	nofollow = false,
	ogType = 'website',
	cover = 'https://dyne.org/social/facebook.jpg',
} = Astro.props;

const title = typeof suppliedTitle === 'string' && suppliedTitle.trim() ? suppliedTitle.trim() : SITE.title;
const description =
	typeof suppliedDescription === 'string' && suppliedDescription.trim()
		? suppliedDescription.trim()
		: SITE.description;
const robots = [noindex ? 'noindex' : '', nofollow ? 'nofollow' : ''].filter(Boolean).join(', ');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="fediverse:creator" content="@dyneorg@mastodon.social" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site guide" />
<link rel="service-desc" type="application/json" href="/openapi.json" title="OpenAPI service description" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" title="XML sitemap" />
<link rel="alternate" type="application/nostr+json" href="/.well-known/nostr.json" title="NIP-05 identity document" />
<link rel="alternate" type="text/markdown" href="/404.md" title="Page-not-found recovery help" />
<meta name="google-site-verification" content="rDWLpshyBbtXZr-9SYj1GMUoH-QTHQTc1i6RrBnSE-Q" />
<!-- `frame-ancestors` is enforced only as an HTTP response header. GitHub Pages
	cannot supply it for this static site, so a meta CSP would only create console errors. -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}
<meta property="fb:app_id" content="140650172370" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={cover} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Dyne.org" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@DyneOrg" />
<meta name="twitter:creator" content="@DyneOrg" />
<script>
	// Simple frame-bust: move top window to this page if framed.
	if (window.top !== window.self) {
		try {
			// prefer replace to avoid history entry
			window.top.location.replace(window.location.href);
		} catch (e) {
			// if cross-origin prevents top navigation, fallback to break out by opening self
			window.self.open(location.href, '_top');
		}
	}
</script>
