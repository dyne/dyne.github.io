---
import ProjectCard from '../ProjectCard.astro';
import { getCollection, render } from 'astro:content';

const projects = await Promise.all(
	(await getCollection('what-we-do'))
		.sort((left, right) => left.id.localeCompare(right.id))
		.map(async (project) => ({ ...project, Content: (await render(project)).Content })),
);
---

<div class="flex flex-col gap-y-8">
	<div class="grid grid-cols lg:grid-cols-2 gap-6 px-8">
		{
			projects.map((p) => {
				const { logo, name, link, download } = p.data;
				return (
					<ProjectCard logo={logo} title={name} url={link} download={download}>
						<p.Content />
					</ProjectCard>
				);
			})
		}
	</div>
	<div class="text-center">
		<a href="/software" class="inline-block max-w-full px-4 text-2xl text-saccent underline underline-offset-4">Browse all software</a>
	</div>
</div>

<style>
	@media (max-width: 639px) { .px-8 { padding-inline: 16px; } }
</style>
