---
import { getCollection, render } from 'astro:content';

const keywords = await Promise.all(
	(await getCollection('who-we-are'))
		.sort((left, right) => left.id.localeCompare(right.id))
		.map(async (keyword) => ({ ...keyword, Content: (await render(keyword)).Content })),
);

const keywordColorClasses = {
	sustainability: 'bg-sustainability',
	open_source: 'bg-open_source',
	crypto: 'bg-crypto',
	interdisciplinarity: 'bg-interdisciplinarity',
	cybersecurity: 'bg-cybersecurity',
};

const rotationClasses = {
	'rotate-2': 'rotate-2',
	'-rotate-1': '-rotate-1',
};
---

<ul class="lg:px-12 px-0">
	{
		keywords.map((kw) => {
			const colorClass = keywordColorClasses[kw.data.color] ?? 'bg-white';
			const rotationClass = rotationClasses[kw.data.rotation] ?? '';
			return (
			<>
				<li
					class={`flipper text-black ${colorClass} ${rotationClass} rounded-[22px] lg:rounded-3xl lg:px-12 min-h-max`}
				>
					<h2
						class={`front py-3 tracking-tighter top-0 left-0 font-semibold text-[1.9rem] md:text-[3.4rem] lg:text-mega whitespace-nowrap`}
					>
						{kw.data.word}
					</h2>
					<div
						class="back absolute top-0 left-0 p-2 text-xs md:text-lg md:p-5 lg:p-20 lg:text-3xl md:w-[80%] min-h-fit hidden md:block"
					><kw.Content /></div>
				</li>
				<li class="block md:hidden py-4"><kw.Content /></li>
			</>
			);
		})
	}
</ul>
<style>
	.flipper {
		overflow: hidden;
		transform-style: preserve-3d;
		transition: 0.5s;
		padding-left: 10%;
		margin-left: -10%;
		width: 120%;
	}

	@media screen and (min-width: 768px) {
		.flipper:hover .front {
			transform: rotateX(-180deg);
		}
	}
	.flipper:hover .back {
		transform: translateX(0);
	}

	.front {
		backface-visibility: hidden;
		transform: rotateX(0deg);
		transition: 0.5s;
	}

	.back {
		backface-visibility: hidden;
		transform: translateX(100%);
		transition: 0.5s;
		animation: slide-out 0.5s forward;
	}

	.slide-in {
		animation: slide-in 0.5s forwards;
		-webkit-animation: slide-in 0.5s forwards;
	}

	.slide-out {
		animation: slide-out 0.5s forwards;
		-webkit-animation: slide-out 0.5s forwards;
	}

	@keyframes slide-in {
		100% {
			transform: translateX(0%);
		}
	}

	@-webkit-keyframes slide-in {
		100% {
			-webkit-transform: translateX(0%);
		}
	}

	@keyframes slide-out {
		0% {
			transform: translateX(0%);
		}
		70% {
			transform: translateX(-70%);
		}
	}

	@-webkit-keyframes slide-out {
		0% {
			-webkit-transform: translateX(0%);
		}
		100% {
			-webkit-transform: translateX(-70%);
		}
	}
</style>
