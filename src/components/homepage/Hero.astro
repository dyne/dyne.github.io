---
import * as copy from '../../content/hero/index.md';
import Button from '~/components/Button.astro';
import Caffuda from '../Caffuda.astro';
import ButtonsGroup from '../ButtonsGroup.astro';
---

<div class="flex flex-col lg:flex-row items-center space-y-20 lg:space-y-0 px-10 lg:py-36">
	<div class="flex flex-col w-full space-y-8 tracking-tight">
		<h1 class="font-display font-extrabold leading-heading text-6xl text-saccent">Dyne.org is a digital community and free software foundry.</h1>
		<div class="font-display leading-heading text-2xl md:text-3xl text-saccent italic" set:html={copy.compiledContent()} />
		<p class="max-w-3xl text-lg md:text-xl font-body leading-body text-saccent">
			We share tools, practices and narratives that empower artists, creatives and citizens
			in the digital age.
		</p>
		<ButtonsGroup>
			<Button href={copy.frontmatter.url} text={copy.frontmatter.CTA} inverted={true} />
			<Button href={copy.frontmatter.url1} text={copy.frontmatter.CTA1} />
			<Button href={copy.frontmatter.url2} text={copy.frontmatter.CTA2} inverted={true} />
			<Button href={copy.frontmatter.url3} text={copy.frontmatter.CTA3} inverted={true} />
		</ButtonsGroup>
	</div>
	<Caffuda />
</div>
