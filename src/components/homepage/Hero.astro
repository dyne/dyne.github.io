---
import * as copy from '../../content/hero/index.md';
import Button from '~/components/Button.astro';
import Caffuda from '../Caffuda.astro';
import ButtonsGroup from '../ButtonsGroup.astro';
---

<div class="flex flex-col lg:flex-row items-center space-y-10 lg:space-y-0 px-10 py-24 lg:py-32">
	<div class="flex flex-col w-full space-y-6 tracking-tight">
		<h1 class="font-display font-extrabold leading-heading text-5xl lg:text-6xl text-theme-on-surface">
			Free to share code. Code to share freedom.
		</h1>

		<p class="font-body leading-body text-2xl lg:text-3xl text-theme-on-surface">
			Dyne.org is a digital community and free software foundry.
		</p>

		<p class="max-w-3xl text-xl md:text-2xl font-body leading-body text-theme-on-surface">
			We share tools, practices and narratives that empower artists, creatives and citizens
			in the digital age.
		</p>

		<ButtonsGroup>
			<Button href={copy.frontmatter.url} text={copy.frontmatter.CTA} />
			<Button href={copy.frontmatter.url1} text={copy.frontmatter.CTA1} inverted={true} />
		</ButtonsGroup>
	</div>

	<Caffuda />
</div>
