---
const { creator, title, link } = Astro.props;
const snippet = Astro.props['content:encodedSnippet'];
const media = Astro.props['media:content'];
---

<div class="pb-4 flex flex-col">
	<a href={link}>
		<figure class="mb-4">
			<img class="w-full aspect-video object-cover" src={media['$'].url} alt="" width="1200" height="675" loading="lazy" decoding="async" />
		</figure>
	</a>
	<div>
		<h3 class="article-title text-4xl md:text-5xl lg:text-6xl text-saccent font-bold"><a href={link}>{title}</a></h3>
		<div class="py-4">
			by <span class="font-medium">{creator}</span>
		</div>

		<p class="text-gray-800 mb-2">
			{snippet}
		</p>
	</div>
	<a
		href="/blog"
		class="mt-4 text-accent cursor-pointer border-2 border-accent hover:bg-saccent hover:text-white hover:border-saccent py-2 px-4 rounded-full w-fit text-2xl whitespace-nowrap"
		>More newsletter issues</a
	>
</div>

<style>
	.article-title { font-size: clamp(1.5rem, calc(1rem + 3vw), 3.75rem); overflow-wrap: anywhere; }
</style>
