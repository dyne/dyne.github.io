---
interface Props {
	name: string;
	address: string;
	href?: string;
}

const { name, address, href } = Astro.props;
---

<div class="bg-sustainability text-white rounded-3xl p-6 flex flex-col gap-3">
	<div class="flex items-center gap-3">
		<slot name="icon" />
		<p class="font-display font-bold text-2xl">{name}</p>
	</div>
	{
		href ? (
			<a href={href} class="text-xs break-words underline decoration-2">
				{address}
			</a>
		) : (
			<p class="text-xs break-words">{address}</p>
		)
	}
	<button
		type="button"
		data-wallet-copy={address}
		data-wallet-name={name}
		aria-label={`Copy ${name} wallet address to clipboard`}
		class="self-start text-sm font-semibold underline decoration-2 decoration-white/60 hover:decoration-white rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
	>
		<span data-copy-label>Copy address</span>
	</button>
</div>

<script>
	const status = document.querySelector('#wallet-copy-status');
	document.querySelectorAll('[data-wallet-copy]').forEach((button) => {
		const label = button.querySelector('[data-copy-label]');
		const defaultLabel = label ? label.textContent : 'Copy address';
		let resetTimer;

		button.addEventListener('click', async () => {
			const address = button.getAttribute('data-wallet-copy') ?? '';
			const name = button.getAttribute('data-wallet-name') ?? 'wallet';
			try {
				await navigator.clipboard.writeText(address);
				if (status) status.textContent = `${name} wallet address copied to clipboard.`;
				if (label) label.textContent = 'Copied!';
			} catch {
				if (status) status.textContent = `Could not copy the ${name} wallet address. Please copy it manually.`;
				if (label) label.textContent = 'Copy failed';
			}
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				if (label) label.textContent = defaultLabel;
			}, 2000);
		});
	});
</script>
