---
interface Props {
	amount: string;
	label: string;
	description?: string;
	featured?: boolean;
}

const { amount, label, description, featured = false } = Astro.props;
---

<div
	class={`flex flex-col gap-1 rounded-3xl text-left ${
		featured ? 'bg-accent text-white p-8' : 'bg-white text-saccent p-6'
	}`}
>
	<span class={`font-display font-bold ${featured ? 'text-4xl md:text-5xl' : 'text-3xl'}`}>{amount}</span>
	<span class={`font-semibold ${featured ? 'text-xl' : 'text-lg'}`}>{label}</span>
	{description && <span class={`text-sm leading-6 ${featured ? 'opacity-90' : 'opacity-80'}`}>{description}</span>}
</div>
