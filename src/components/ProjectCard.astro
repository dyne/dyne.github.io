---
import Button from './Button.astro';

const { logo, title, subtitle, url, download, variant = 'default', headingLevel } = Astro.props;
const isFeatured = variant === 'featured';

// fallback initials for when no logo is available, matching the pattern in Software.astro.
// Titles often use a "Name :: subtitle" convention, so words are matched as
// alphanumeric runs rather than split on whitespace, to skip the "::" itself.
const initials = (title || '')
	.match(/[A-Za-z0-9]+/g)
	?.slice(0, 2)
	.map((word) => word[0])
	.join('')
	.toUpperCase();
const logoAltText = title ? `${title} logo` : 'logo';

// optional heading tag (e.g. for Software.astro's featured usage, which needs
// a real h2/h3 in the page outline); default catalogue cards stay plain links
const Heading = headingLevel ? `h${Math.min(Math.max(Number(headingLevel) || 2, 1), 6)}` : null;
---

<div
	class={`transition duration-500 ease-in-out transform shadow-2xl border-4 border-baccent bg-primary-light text-taccent hover:border-accent hover:shadow-none hover:bg-white rounded-[40px] ${isFeatured ? 'p-10 md:p-12' : 'p-7'}`}
>
	<div class={`w-full h-full flex p-4 ${isFeatured ? 'gap-10' : 'gap-8'}`}>
		<div
			class={`flex-none hidden md:flex md:items-center md:justify-center bg-origin-content bg-contain bg-center bg-no-repeat rounded-full ring-2 ring-saccent ${isFeatured ? 'w-40 h-40 lg:w-32 lg:h-32' : 'w-32 h-32 lg:w-20 lg:h-20'}`}
			style={logo ? `background-image: url(${logo})` : undefined}
			role={logo ? 'img' : undefined}
			aria-label={logo ? logoAltText : undefined}
		>
			{!logo && <span class="font-bold text-taccent" aria-hidden="true">{initials || 'SW'}</span>}
		</div>
		<div>
			<div class="flex flex-row items-center gap-4 flex-wrap">
				{Heading ? (
					<Heading class={`not-prose font-display font-bold leading-heading ${isFeatured ? 'text-4xl' : 'text-2xl'}`}>
						<a href={url} class="no-underline text-current">{title}</a>
					</Heading>
				) : (
					<a href={url} class={`font-display font-bold leading-heading no-underline ${isFeatured ? 'text-4xl' : 'text-2xl'}`}>{title}</a>
				)}
				{subtitle && <span class={`font-semibold ${isFeatured ? 'text-xl' : 'text-lg'}`}>{subtitle}</span>}

				<div
					class={`flex md:hidden items-center justify-center bg-origin-content bg-contain bg-center bg-no-repeat rounded-full border-[0.5px] border-accent ${isFeatured ? 'w-12 h-12' : 'w-10 h-10'}`}
					style={logo ? `background-image: url(${logo})` : undefined}
					role={logo ? 'img' : undefined}
					aria-label={logo ? logoAltText : undefined}
				>
					{!logo && <span class="font-bold text-xs text-taccent" aria-hidden="true">{initials || 'SW'}</span>}
				</div>
			</div>
			<div class={`text-gray-800 font-body leading-body mt-4 mb-10 ${isFeatured ? 'text-xl' : 'text-lg'}`}>
				<slot />
			</div>
			<div class="flex flex-row flex-wrap space-x-3 mt-4 no-underline">
				<Button href={url} text="Learn more..." inverted={true} cls={isFeatured ? 'no-underline' : 'text-sm no-underline'} />
				{download && <Button href={download} text="Download" cls={isFeatured ? 'no-underline' : 'text-sm no-underline'} />}
			</div>
		</div>
	</div>
</div>
