---
import GlobalAssets from '~/components/GlobalAssets.astro';
import MetaTags from '~/components/MetaTags.astro';
import { SITE } from '~/config.mjs';
import '@fontsource/syne/400.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';

const { meta = {} } = Astro.props;
const routeCanonical = new URL(Astro.url.pathname, SITE.origin);

// Pages normally identify themselves from their generated route.  An explicit
// canonical is reserved for deliberate aliases (including static redirect
// stubs), and is constrained to a web URL so malformed frontmatter cannot
// produce an unsafe link element.
const canonicalOverride = typeof meta.canonical === 'string' ? meta.canonical.trim() : '';
let canonical = routeCanonical.href;
if (canonicalOverride) {
	try {
		const candidate = new URL(canonicalOverride, SITE.origin);
		if (candidate.protocol === 'https:' || candidate.protocol === 'http:') {
			candidate.hash = '';
			canonical = candidate.href;
		}
	} catch {
		// Keep the route-derived canonical when an override is not a valid URL.
	}
}

const pageMeta = { ...meta, canonical };
---

<!doctype html>
<html lang="en">
	<head>
		<!--
			Theme must be resolved before first paint to avoid a flash of the wrong
			theme. This is intentionally the first thing in <head>, is:inline (so
			Astro leaves it as a plain synchronous script, not a deferred module),
			and self-contained (no imports, no dependency on GlobalAssets.astro,
			which now only handles non-theme DOM wiring further down the page).

			First visit: use the saved preference if any, otherwise
			prefers-color-scheme, otherwise Light. Every visit persists the
			resolved theme, so later visits keep it even if the OS-level
			preference changes afterwards.
		-->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var theme =
						stored === 'dark' || stored === 'light'
							? stored
							: window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
					document.documentElement.classList.toggle('dark', theme === 'dark');
					localStorage.setItem('theme', theme);
				} catch (e) {}
			})();
		</script>
		<MetaTags {...pageMeta} />
	</head>

	<body class="bg-background duration-500">
		<a class="skip-link" href="#content">Skip to main content</a>
		<slot />
		<GlobalAssets />
	</body>
</html>

<style is:global>
	.skip-link {
		position: fixed;
		left: 1rem;
		top: 1rem;
		z-index: 100;
		transform: translateY(-200%);
		border-radius: 0.5rem;
		background: #000;
		color: #fff;
		padding: 0.75rem 1rem;
		font-weight: 700;
	}
	.skip-link:focus-visible { transform: translateY(0); }
	:focus-visible {
		outline: 3px solid var(--accent-color, #423e8e);
		outline-offset: 4px;
	}
</style>
