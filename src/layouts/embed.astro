---
import Layout from '~/layouts/Layout.astro';
import { marked } from 'marked';

const { content } = Astro.props;
const response = await fetch(content.destination);
const sourceUrl = new URL(content.destination);
const html = String(marked.parse(await response.text())).replace(
	/\b(src|href)="(?![a-z]+:|\/|#)([^"]+)"/gi,
	(_, attribute, value) => `${attribute}="${new URL(value, sourceUrl).href}"`
);
---

<Layout content={content}>
	<div set:html={html} />
</Layout>
