---
import Layout from '~/layouts/Layout.astro';
import { marked } from 'marked';
import { fetchRemoteText } from '~/lib/remote-content.mjs';

const { content } = Astro.props;
const sourceUrl = new URL(content.destination);
const source = await fetchRemoteText(content.destination).catch(() => 'This embedded resource is temporarily unavailable.');
const html = String(marked.parse(source)).replace(
	/\b(src|href)="(?![a-z]+:|\/|#)([^"]+)"/gi,
	(_, attribute, value) => `${attribute}="${new URL(value, sourceUrl).href}"`
);
---

<Layout content={content}>
	<div set:html={html} />
</Layout>
