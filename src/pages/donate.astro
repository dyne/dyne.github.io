---
import Button from '~/components/Button.astro';
import Layout from '~/layouts/HomepageLayout.astro';
import Link from '~/components/Link.astro';
import Section from '~/components/Section.svelte';
import DonationOption from '~/components/donate/DonationOption.astro';
import WalletCard from '~/components/donate/WalletCard.astro';
// Icons
import Kofi from '~/components/icons/donations/kofi.astro';
import Patreon from '~/components/icons/donations/patreon.astro';
import Github from '~/components/icons/donations/github.astro';
import SponsorLink from '~/components/SponsorLink.astro';
import Bitcoin from '~/components/icons/donations/bitcoin.astro';
import Monero from '~/components/icons/donations/monero.astro';
import Ethereum from '~/components/icons/donations/ethereum.astro';

const meta = { title: 'Dyne.org :: Donations' };

// TODO: replace with the real PayPal donation link once available.
// Kept as a single named constant so it's easy to wire up later.
const PAYPAL_DONATE_URL = '';

// Suggested amounts are UI-only: there is no separate checkout per amount,
// they all lead to the single PayPal CTA below.
// Custom is listed first and marked as featured so it stays visually dominant;
// 5€ and 25€ remain secondary, smaller options.
const oneTimeOptions = [
	{
		amount: 'Custom',
		label: 'Choose your amount',
		description: 'Every contribution matters, whatever the size.',
		featured: true,
	},
	{
		amount: '5€',
		label: 'Small gesture',
		description: 'A simple way to support our daily work.',
	},
	{
		amount: '25€',
		label: 'Keep things running',
		description: 'Help us maintain servers, tools and free software projects.',
	},
];

const wallets = [
	{
		name: 'Bitcoin',
		address: 'bc1qz9wz2f9swcefra2tfrhk4fx49evqsv03m9nx4l',
		icon: Bitcoin,
	},
	{ name: 'Ethereum', address: '0x9b8aF04912c462b39bB4f26FeA22E7a70e3b8677', icon: Ethereum },
	{
		name: 'Monero',
		href: 'monero://49GZLW2J65c9tNDFEjv6gVVVHFhQYwfzmZMQu4tSeYFbPXxD61nWvGU6cSkCBEyixFErrmSPxWFdN6djuQX8nXBiBS3hqWE?tx_message=donation%20to%20dyne.org',
		address: '49GZLW2J65c9tNDFEjv6gVVVHFhQYwfzmZMQu4tSeYFbPXxD61nWvGU6cSkCBEyixFErrmSPxWFdN6djuQX8nXBiBS3hqWE',
		icon: Monero,
	},
];
---

<Layout meta={meta}>
	<div class="flex flex-col lg:space-y-20 pt-8 md:pt-16">
		<div class="space-y-8 lg:space-y-12">
		<!-- Hero + One-time support -->
		<div class="flex flex-col gap-12 lg:grid lg:grid-cols-2 lg:gap-8 lg:items-center">
			<!-- Hero -->
			<div class="space-y-6 px-6 md:px-12 text-center lg:text-left max-w-2xl mx-auto lg:mx-0">
				<h1 class="font-display font-extrabold leading-heading text-4xl lg:text-5xl text-saccent">
					Help making an impact by <em class="bg-primary">supporting</em> our work
				</h1>
				<p class="text-xl">
					Year after year, Dyne.org produces free, safe and easy to use technologies that are used by millions of users
					worldwide to inspire, communicate, share and create.
				</p>
				<p class="text-lg">
					Choose how you'd like to support us:
					<Link href="#one-time">one-time donation</Link>, <Link href="#recurring">recurring support</Link> or <Link href="#crypto">crypto</Link>.
				</p>
			</div>
			<!-- One-time support (kept, PayPal temporarily unavailable so it's no longer the primary flow) -->
<!-- 			<Section id="one-time" title="One-time support">
				<div class="space-y-8 max-w-4xl mx-auto">
					<div>
						<p class="text-white/70 text-sm mb-4 text-center sm:text-left">
							Suggested amounts — choose any amount you like via PayPal.
						</p>
						<div class="space-y-4">
							{oneTimeOptions.filter((option) => option.featured).map((option) => <DonationOption {...option} />)}
							<div class="grid grid-cols-2 gap-4">
								{oneTimeOptions.filter((option) => !option.featured).map((option) => <DonationOption {...option} />)}
							</div>
						</div>
					</div>

					<div class="flex justify-center">
						<Button
							href={PAYPAL_DONATE_URL || '#'}
							text="Donate with PayPal"
							cls="text-3xl px-10 py-3"
						/>
					</div>
				</div>
			</Section> -->

			<!-- Recurring support (featured hero flow, while PayPal one-time is unavailable) -->
			<Section id="recurring-hero" title="Recurring support">
				<div class="space-y-6 max-w-4xl mx-auto">
					<div class="flex flex-col gap-3 bg-accent text-white rounded-3xl p-8">
						<span class="self-start text-xs font-bold uppercase tracking-wide bg-white text-accent rounded-full px-3 py-1">
							Recommended
						</span>
						<p class="font-display font-bold text-2xl">Ko-fi</p>
						<p class="text-white/90">The easiest way to support our work and join our community.</p>
						<SponsorLink href="https://ko-fi.com/dyneorg" text="Ko-fi"><Kofi size={32} /></SponsorLink>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div class="flex flex-col gap-2 bg-white text-saccent rounded-3xl p-6">
							<p class="font-display font-bold text-lg">Patreon</p>
							<p class="text-sm opacity-80">Support Dyne.org through recurring memberships and community support.</p>
							<SponsorLink href="https://patreon.com/dyneorg" text="Patreon"><Patreon size={28} /></SponsorLink>
						</div>
						<div class="flex flex-col gap-2 bg-white text-saccent rounded-3xl p-6">
							<p class="font-display font-bold text-lg">GitHub Sponsors</p>
							<p class="text-sm opacity-80">Support the code and tools we build in the open.</p>
							<SponsorLink href="https://github.com/sponsors/dyne" text="GitHub"><Github size={28} /></SponsorLink>
						</div>
					</div>
				</div>
			</Section>
		</div>

		<!-- Navigation bridge: surface the alternatives right at the one-time decision point -->
		<div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-0 w-full">
			<div class="bg-primary-40 rounded-3xl p-6 text-center text-saccent">
				<p class="text-lg">
					Prefer something else? Explore <Link href="#recurring">recurring support</Link> or
					<Link href="#crypto">crypto support</Link>.
				</p>
			</div>
		</div>
		</div>

		<!-- Recurring support -->
<!-- 		<Section id="recurring" title="Recurring support">
			<span slot="description">
				Support Dyne.org regularly and become part of our community of sustainers. Choose the platform that works
				best for you.
			</span>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto items-stretch">
				<div class="flex flex-col gap-3 bg-primary-40 rounded-3xl p-6">
					<span class="self-start text-xs font-bold uppercase tracking-wide bg-accent text-white rounded-full px-3 py-1">
						Recommended
					</span>
					<p class="font-display font-bold text-xl text-saccent">Ko-fi</p>
					<p class="text-saccent text-sm">The easiest way to support our work and join our community.</p>
					<SponsorLink href="https://ko-fi.com/dyneorg" text="Ko-fi"><Kofi size={32} /></SponsorLink>
				</div>

				<div class="flex flex-col gap-3 bg-primary-40 rounded-3xl p-6">
					<p class="font-display font-bold text-xl text-saccent">Patreon</p>
					<p class="text-saccent text-sm">Support Dyne.org through recurring memberships and community support.</p>
					<SponsorLink href="https://patreon.com/dyneorg" text="Patreon"><Patreon size={32} /></SponsorLink>
				</div>

				<div class="flex flex-col gap-3 bg-primary-40 rounded-3xl p-6">
					<p class="font-display font-bold text-xl text-saccent">GitHub Sponsors</p>
					<p class="text-saccent text-sm">Support the code and tools we build in the open.</p>
					<SponsorLink href="https://github.com/sponsors/dyne" text="GitHub"><Github size={32} /></SponsorLink>
				</div>
			</div>
		</Section> -->

		<!-- Crypto support -->
		<Section id="crypto" title="Crypto support">
			<span slot="description">Support with cryptocurrency by sending a donation directly to one of our wallets.</span>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
				{
					wallets.map((wallet) => {
						const Icon = wallet.icon;
						return (
							<WalletCard name={wallet.name} address={wallet.address} href={wallet.href}>
								<Icon size={32} slot="icon" />
							</WalletCard>
						);
					})
				}
			</div>
		</Section>
	</div>

	<p id="wallet-copy-status" class="sr-only" aria-live="polite" role="status"></p>
</Layout>
