---
import Layout from '~/layouts/Layout.astro';
import links from '../../content/social/linktree.json';
import quicklinks from '../../content/social/quicklinks.json';
const [github, newsletter, history] = quicklinks;
---

<Layout
	content={{
		title: 'Join the community',
		description: 'Find a discussion, contribute to a project, or contact the Dyne.org foundation.',
	}}
>
	<div class="participation" data-participation>
		<nav aria-label="Participation routes" class="route-links">
			<a href="#discussion">Join a discussion</a>
			<a href="#contribute">Contribute to a project</a>
			<a href="#foundation">Contact the foundation</a>
		</nav>
		<section id="discussion" aria-labelledby="discussion-heading">
			<h2 id="discussion-heading">Join a discussion</h2>
			<p>Meet the community in a chat, find a project channel, or follow Dyne's news and videos. Choose the platform that works for you.</p>
			{links.map((group, index) => (
				<section class="channel-group" aria-labelledby={`channel-group-${index}`}>
					<h3 id={`channel-group-${index}`}>{group.group_name}</h3>
					<p>{group.description}</p>
					<ul class="channels" role="list">
						{group.links.map(channel => (
							<li>
								<h4>{channel.name}</h4>
								<p>{channel.tagline}</p>
								<a href={channel.link} class="channel-action">{channel.cta || 'Join'}<span class="sr-only">: {channel.name}</span></a>
							</li>
							))}
					</ul>
				</section>
			))}
		</section>
		<section id="contribute" aria-labelledby="contribute-heading">
			<h2 id="contribute-heading">Contribute to a project</h2>
			<p>Browse the software to find a project, then explore its source code or join its discussion. Dyne's GitHub is another starting point for code contributions.</p>
			<div class="route-links">
				<a href="/software">Explore software</a>
				<a href={github.link}>{github.cta}: explore the code</a>
			</div>
			<p>Get updates through the <a href={newsletter.link}>{newsletter.cta}</a>, or explore <a href={history.link}>{history.cta}</a>.</p>
		</section>
		<section id="foundation" aria-labelledby="foundation-heading">
			<h2 id="foundation-heading">Contact the foundation</h2>
			<p>For a conversation, start with one of the <a href="#discussion">community channels above</a>. The Dyne.org foundation's postal address is:</p>
			<address>Dyne.org foundation<br />Haparandadam 7-A1 1013AK Amsterdam</address>
		</section>
	</div>
</Layout>

<style>
	.participation { overflow-wrap: anywhere; }
	:global(main#content h1) { overflow-wrap: normal; hyphens: auto; font-size: 1.5rem; line-height: 1.2; text-wrap: balance; }
	@media (min-width: 640px) { :global(main#content h1) { font-size: 3rem; } }
	@media (max-width: 359px) { :global(main#content h1) { font-size: 1.25rem; } }
	.participation > section { margin-block: 3rem; scroll-margin-top: 2rem; }
	.participation h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.2; }
	.participation h3 { font-size: 1.75rem; line-height: 1.25; margin: 0; }
	.participation h4 { font-size: 1.4rem; line-height: 1.3; margin: 0; }
	.participation p { max-width: 70ch; }
	.route-links { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
	.route-links a, .channel-action { text-decoration: underline; text-underline-offset: .2em; }
	.channel-group { margin-block: 2.5rem; padding-block-start: 1.5rem; border-top: 1px solid currentColor; }
	.channel-group > p { margin-block: .75rem 1.5rem; }
	.channels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 2rem; list-style: none; padding: 0; margin: 0; }
	.channels li { min-width: 0; padding: 0; margin: 0; }
	.channels p { font-size: 1.125rem; line-height: 1.6; margin-block: .5rem .75rem; }
	.channel-action { display: inline-block; font-size: 1.125rem; padding-block: .3rem; }
	address { font-style: normal; }
</style>
